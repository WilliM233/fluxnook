# Copy to .env.local. These three are the Supabase CLI's fixed local defaults
# (`npx supabase status` prints them); they belong to no hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only, never committed: paste the SECRET_KEY value that
# `npx supabase status` prints. The server writes covers to Storage with it.
SUPABASE_SECRET_KEY=

# Server-only: the TMDB v4 read access token, from
# https://www.themoviedb.org/settings/api. Empty means search is off.
TMDB_API_KEY=
